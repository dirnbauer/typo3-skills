# Trusted full-content editor profile.
options {
    clearCache.pages = 1
    clearCache.all = 0
    defaultResourcesViewMode = list

    # Keep Visual Editor labels unambiguous across pages and sites.
    pageTree {
        showPageIdWithTitle = 1
        showDomainNameWithTitle = 1
    }

    file_list {
        enableClipBoard = selectable
        displayColumnSelector = 1
        enableDisplayThumbnails = selectable
        primaryActions = view,metadata,translations,delete,copy,cut,rename,replace,download,upload
    }

    liveSearch.actions {
        pages.default = layout
        tt_content.default = layout
    }
}

# Make TOTP the recommended primary provider; recovery codes remain available as fallback.
auth.mfa.recommendedProvider = totp

# Basic EXT:workspaces preview-link lifetime; ignored when Workspaces is absent.
options.workspaces.previewLinkTTLHours = 48

# New pages inherit both owners and the standard user/group/everybody rights (31/27/1).
page.TCEMAIN.permissions {
    userid = copyFromParent
    groupid = copyFromParent
    user = show,edit,delete,new,editcontent
    group = show,edit,new,editcontent
    everybody = show
}

admPanel {
    hide = 0
    enable {
        cache = 1
        debug = 0
        edit = 1
        info = 1
        preview = 1
        publish = 0
        tsdebug = 0
    }
}
