# Safe baseline for the one main editor group.
options.clearCache.pages = 1
options.clearCache.all = 0

# EXT:visual_editor uses this value in its frontend editing context.
options.pageTree.showPageIdWithTitle = 1

# Make TOTP the recommended primary provider; recovery codes remain available as fallback.
auth.mfa.recommendedProvider = totp

# New pages inherit the parent group and the least-privilege editor page rights (27).
page.TCEMAIN.permissions {
    groupid = copyFromParent
    group = show,edit,new,editcontent
    everybody = 0
}

admPanel {
    hide = 0
    enable {
        preview = 1
    }
}
