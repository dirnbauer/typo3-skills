{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dirnbauer/webconsulting-skills/skills/typo3-upgrade-run/assets/schemas/state.schema.json",
  "title": "typo3-upgrade-run run state",
  "description": "The single source of truth for graph-node and bounded-loop preconditions. Never derived from the transcript; always read from disk.",
  "type": "object",
  "required": ["schema", "run_id", "runtime", "target", "contract_a", "contract_b", "baselines", "fingerprints", "loops", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "typo3-upgrade-run/state@1" },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$",
      "description": "YYYY-MM-DD-<project-slug>"
    },
    "runtime": {
      "type": "object",
      "required": ["started_at", "deadline_at", "max_hours", "closure_reserve_hours"],
      "additionalProperties": false,
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "sealed_at": { "type": ["string", "null"], "format": "date-time" },
        "budget_policy": { "enum": ["site-size-v2", "overnight-v1", null] },
        "size_profile": { "enum": ["small", "large", "huge", null] },
        "size_evidence_ref": { "type": ["string", "null"] },
        "forecast_ref": { "type": "string" },
        "forecast_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "migration_cutoff_at": { "type": ["string", "null"], "format": "date-time" },
        "deadline_at": { "type": ["string", "null"], "format": "date-time" },
        "max_hours": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 48 },
        "closure_reserve_hours": { "type": ["number", "null"], "minimum": 2, "maximum": 12 }
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "trusted_origin"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "trusted_origin": {
          "type": "string",
          "format": "uri",
          "description": "The one origin credentials and navigation are allowed to reach. Scheme included; never rewritten."
        },
        "ddev_project": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "run_dir": { "type": "string", "default": ".typo3-update" }
      }
    },
    "target": {
      "type": "object",
      "required": ["kind", "typo3_from", "typo3_to", "php_from", "php_to"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["project", "sitepackage", "extension"] },
        "typo3_from": { "type": "string" },
        "typo3_to": { "type": "string", "default": "14.3" },
        "php_from": { "type": "string" },
        "php_to": {
          "type": "string",
          "default": "8.4",
          "description": "8.4 is the standard target; 8.5 when the whole dependency set resolves on it."
        },
        "php_85_evaluated": {
          "type": ["boolean", "null"],
          "description": "True once composer why-not php 8.5 has actually been run. null means not yet checked."
        },
        "php_85_blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contract_a": {
      "type": "object",
      "required": ["phase", "status"],
      "additionalProperties": false,
      "properties": {
        "phase": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "status": { "enum": ["open", "closed", "blocked"] },
        "closed_at": { "type": ["string", "null"], "format": "date-time" },
        "closure_ref": { "type": ["string", "null"] },
        "verification": {
          "type": "object", "additionalProperties": false,
          "required": ["at", "evidence_ref", "epoch_hash", "manifest_hash"],
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "evidence_ref": { "type": "string" },
            "epoch_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "manifest_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        }
      }
    },
    "contract_b": {
      "type": "object",
      "required": ["unlocked", "tracks"],
      "additionalProperties": false,
      "properties": {
        "unlocked": {
          "type": "boolean",
          "description": "Set true only by the Contract A closure certificate. Gate B1.1 compares timestamps."
        },
        "unlocked_at": { "type": ["string", "null"], "format": "date-time" },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["loop_id", "slug", "approval_ref", "baseline_ref", "status"],
            "additionalProperties": false,
            "properties": {
              "loop_id": { "type": "string" },
              "slug": { "type": "string" },
              "approval_ref": { "type": "string" },
              "baseline_ref": { "type": "string" },
              "status": { "enum": ["planned", "open", "green", "aborted", "stopped"] }
            }
          }
        }
      }
    },
    "baselines": {
      "type": "object",
      "description": "A-original is the only baseline a Contract A loop may bind to.",
      "additionalProperties": {
        "type": "object",
        "required": ["sealed"],
        "additionalProperties": false,
        "properties": {
          "sealed": { "type": "boolean" },
          "sealed_at": { "type": ["string", "null"], "format": "date-time" },
          "manifest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "urls": { "type": "integer", "minimum": 0 },
          "captures": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "required": ["environment", "content"],
      "additionalProperties": false,
      "properties": {
        "environment": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "content": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "content_target": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "content_active": { "enum": ["baseline", "target"] },
        "content_transition_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "sealed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "selftest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["never-run", "open", "diagnostic-green", "green", "aborted"] },
        "at": { "type": ["string", "null"], "format": "date-time" },
        "lock_hash": { "type": ["string", "null"] },
        "coverage": { "type": ["string", "null"] },
        "quarantined_captures": {
          "type": "array",
          "maxItems": 0,
          "description": "Deprecated compatibility field. Strict-zero runs require this to remain empty."
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "seed": { "type": "string" }
      }
    },
    "graph": {
      "type": ["object", "null"],
      "required": ["schema", "definition_path", "definition_hash", "status", "nodes", "edges", "locks", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "typo3-upgrade-run/graph-state@1" },
        "definition_path": { "type": "string" },
        "definition_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "status": { "enum": ["active", "complete", "blocked", "invalid"] },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["status", "attempts", "active_since", "completed_at", "outcome", "evidence", "evidence_loop", "history"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["pending", "ready", "running", "passed", "failed", "blocked", "skipped", "invalid"] },
              "attempts": { "type": "integer", "minimum": 0 },
              "active_since": { "type": ["string", "null"], "format": "date-time" },
              "completed_at": { "type": ["string", "null"], "format": "date-time" },
              "outcome": { "type": ["string", "null"] },
              "evidence": { "type": ["string", "null"] },
              "evidence_sha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
              "evidence_loop": { "type": ["string", "null"], "pattern": "^[0-9]{3}$" },
              "applicability_only": { "type": "boolean" },
              "history": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["traversals", "last_at"],
            "additionalProperties": false,
            "properties": {
              "traversals": { "type": "integer", "minimum": 0 },
              "last_at": { "type": ["string", "null"], "format": "date-time" }
            }
          }
        },
        "locks": { "type": "object", "additionalProperties": { "type": "string" } },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "loops": {
      "type": "object",
      "description": "loop_id -> verdict",
      "propertyNames": { "pattern": "^[0-9]{3}$" },
      "additionalProperties": { "enum": ["planned", "open", "green", "aborted", "superseded", "invalid"] }
    },
    "gates": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "approvals": { "type": "array", "items": { "type": "string", "pattern": "^APR-[0-9]{3}$" } },
    "decisions": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{3}$" } },
    "snapshots": { "type": "array", "items": { "type": "string" } },
    "open_findings": { "type": "integer", "minimum": 0 },
    "blocked": {
      "type": ["object", "null"],
      "description": "Non-null means the run is stopped and waiting on the user.",
      "required": ["reason", "since", "loop_id"],
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string" },
        "since": { "type": "string", "format": "date-time" },
        "loop_id": { "type": "string" },
        "evidence_ref": { "type": ["string", "null"] }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
