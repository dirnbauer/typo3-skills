{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dirnbauer/webconsulting-skills/skills/typo3-upgrade-run/assets/schemas/loop-report.schema.json",
  "title": "typo3-upgrade-run executable loop report",
  "description": "The schema for report.json emitted by t3u gate from the selected loop's HTTP, DOM and visual reports.",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "harness",
    "run",
    "inputs",
    "verdict",
    "counts",
    "findings",
    "stages",
    "findingsByClass",
    "blockingReasons",
    "residualFindings",
    "idempotence",
    "redaction"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "typo3-upgrade-run/loop/v1" },
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "loop" },
    "harness": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "t3u" },
        "version": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "required": ["runId", "loopId", "track", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "loopId": { "type": "string", "pattern": "^[0-9]{3}$" },
        "track": { "enum": ["harness", "invariance", "elevation", "report"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "inputs": {
      "type": "object",
      "required": [
        "manifestHash",
        "environmentFingerprintHash",
        "contentFingerprintHash",
        "selftestLockHash"
      ],
      "additionalProperties": false,
      "properties": {
        "manifestHash": { "type": "string", "minLength": 1 },
        "environmentFingerprintHash": { "type": "string", "minLength": 1 },
        "contentFingerprintHash": { "type": "string", "minLength": 1 },
        "selftestLockHash": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": { "enum": ["pass", "findings", "invalid", "error"] },
    "counts": { "$ref": "#/$defs/classCounts" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "class", "severity", "status"],
        "properties": {
          "id": { "type": "string" },
          "target": { "type": "string" },
          "class": {
            "enum": [
              "regression",
              "declared-change",
              "pre-existing",
              "harness-noise",
              "environment",
              "content-drift",
              "improvement"
            ]
          },
          "severity": { "enum": ["blocker", "major", "minor", "info"] },
          "status": { "enum": ["open", "closed"] }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["stage", "verdict", "counts"],
        "additionalProperties": false,
        "properties": {
          "stage": { "enum": ["http", "dom", "visual"] },
          "verdict": { "enum": ["pass", "findings", "invalid", "error"] },
          "counts": { "type": "object" }
        }
      }
    },
    "findingsByClass": { "$ref": "#/$defs/classCounts" },
    "blockingReasons": { "type": "array", "items": { "type": "string" } },
    "residualFindings": { "type": "array", "items": { "type": "string" } },
    "idempotence": {
      "type": "object",
      "required": ["ran", "diffCount"],
      "additionalProperties": false,
      "properties": {
        "ran": { "const": true },
        "diffCount": { "type": "integer", "minimum": 0 }
      }
    },
    "redaction": {
      "type": "object",
      "required": ["applied", "profile", "rules"],
      "additionalProperties": false,
      "properties": {
        "applied": { "type": "boolean" },
        "profile": { "enum": ["local", "share"] },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "classCounts": {
      "type": "object",
      "required": [
        "regression",
        "declared-change",
        "pre-existing",
        "harness-noise",
        "environment",
        "content-drift",
        "improvement",
        "unclassified"
      ],
      "additionalProperties": false,
      "properties": {
        "regression": { "type": "integer", "minimum": 0 },
        "declared-change": { "type": "integer", "minimum": 0 },
        "pre-existing": { "type": "integer", "minimum": 0 },
        "harness-noise": { "type": "integer", "minimum": 0 },
        "environment": { "type": "integer", "minimum": 0 },
        "content-drift": { "type": "integer", "minimum": 0 },
        "improvement": { "type": "integer", "minimum": 0 },
        "unclassified": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
